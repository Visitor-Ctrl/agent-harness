[Unit]
Description=Profile-scoped OCI secret broker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/opt/agent-harness/current/bin/secret-broker
RuntimeDirectory=agent-harness
RuntimeDirectoryMode=0755
UMask=0077
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/agent-harness
LogsDirectory=agent-harness
LogsDirectoryMode=0700
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
